#: index.php:90 index.php:103
msgid "Add your text label here. Eg. Advertising"
msgstr "Añade aquí su etiqueta de texto. Ej. Anuncios"

#: index.php:193
msgid "AdLabeler"
msgstr "AdLabeler"

#. Name of the plugin
msgid "AdLabeler - Automatically label your AdSense banners"
msgstr "AdLabeler - Etiqueta automáticamente tus banners de AdSense"

#: index.php:73
msgid "AdLabeler Settings"
msgstr "Configuración de AdLabeler"

#. Description of the plugin
msgid ""
"An intuitive plugin that automatically adds labels like \"Ad\" or "
"\"Advertising\" to your AdSense banners, enhancing transparency and user "
"experience."
msgstr ""
"Un plugin intuitivo que añade automáticamente etiquetas como \"Anuncio\" o "
"\"Publicidad\" a sus banners de AdSense, mejorando la transparencia y la "
"experiencia del usuario."

#: index.php:83
msgid "Auto + Manual Ads (Globally)"
msgstr "Anuncios automáticos y manuales (Todo el sitio)"

#: index.php:96
msgid "Automatic Ads Only"
msgstr "Sólo anuncios automáticos"

#. Author of the plugin
msgid "BunkerLATAM"
msgstr "BunkerLATAM"

#: index.php:193
msgid "by"
msgstr "haciendo"

#: index.php:193
msgid "clicking here"
msgstr "clic aquí"

#: index.php:84 index.php:97
